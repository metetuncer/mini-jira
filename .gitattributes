# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-native tooling expects CRLF
*.sln   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files - never touch these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# Keep generated lockfiles out of diff noise and language stats
frontend/package-lock.json  -diff linguist-generated

# Language statistics: don't count docs/config as project code
docs/**      linguist-documentation
*.md         linguist-documentation
